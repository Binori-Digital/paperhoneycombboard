---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  schema?: object;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = '/og-default.jpg',
  schema,
  noindex = false,
} = Astro.props;

const siteUrl = 'https://www.paperhoneycombboard.com';
const canonicalUrl = canonical ? `${siteUrl}${canonical}` : `${siteUrl}${Astro.url.pathname}`;
const fullTitle = title.includes('phb') ? title : `${title} | phb Paper Honeycomb Board`;
---

<!doctype html>
<html lang="en-MY">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:site_name" content="phb Paper Honeycomb Board" />
    <meta property="og:locale" content="en_MY" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <!-- Geo Meta (GEO optimisation) -->
    <meta name="geo.region" content="MY-10" />
    <meta name="geo.placename" content="Johor Bahru, Malaysia" />
    <meta name="geo.position" content="1.4927;103.7414" />
    <meta name="ICBM" content="1.4927, 103.7414" />

    <!-- Structured Data -->
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    <!-- Global Organization Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "phb Paper Honeycomb Board",
      "alternateName": "PHB",
      "legalName": "Quinocycle Sdn Bhd",
      "url": siteUrl,
      "logo": `${siteUrl}/logo.png`,
      "description": "Industrial-grade paper honeycomb board manufacturer serving Malaysia, Singapore, and global export markets. ISPM-15 exempt, up to 80% lighter than wood pallets.",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "No.13, Jalan Taming P/1, Taming Jaya",
        "addressLocality": "Balakong",
        "postalCode": "43300",
        "addressRegion": "Selangor",
        "addressCountry": "MY"
      },
      "areaServed": ["MY", "SG", "ASEAN"],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "sales",
        "telephone": "+60389626381",
        "email": "sales@quinocycle.com",
        "areaServed": ["MY", "SG"],
        "availableLanguage": ["English", "Malay", "Chinese"]
      },
      "sameAs": []
    })} />

    <!-- Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#39FF14" />

    <!-- Page-specific head content (extra JSON-LD schemas etc.) -->
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <a
      href="https://wa.me/60168916381"
      class="wa-float"
      target="_blank"
      rel="noopener"
      aria-label="Chat with us on WhatsApp"
    >
      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
      </svg>
    </a>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    top: -100px;
    left: 1rem;
    background: #39FF14;
    color: #000;
    padding: 0.5rem 1rem;
    font-weight: 700;
    font-size: 0.8rem;
    z-index: 9999;
    transition: top 0.1s;
  }
  .skip-link:focus { top: 1rem; }

  /* Floating WhatsApp button */
  .wa-float {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 900;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #25D366;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.28);
    transition: transform 0.15s ease;
  }
  .wa-float::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #25D366;
    animation: wa-pulse 2s ease-out infinite;
    z-index: -1;
  }
  .wa-float svg {
    width: 30px;
    height: 30px;
    fill: #fff;
  }
  .wa-float:hover,
  .wa-float:focus-visible {
    transform: scale(1.08);
  }
  @keyframes wa-pulse {
    0%   { transform: scale(1); opacity: 0.55; }
    70%  { transform: scale(1.65); opacity: 0; }
    100% { transform: scale(1.65); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wa-float::before { animation: none; }
    .wa-float { transition: none; }
  }
  @media (max-width: 480px) {
    .wa-float { bottom: 1rem; right: 1rem; width: 52px; height: 52px; }
  }
</style>
