---
import Layout from '../layouts/Layout.astro';
import { contactDicts } from '../i18n/locales';

interface Props { locale: string; }
const { locale } = Astro.props;
const t = contactDicts[locale];

const mapsUrl = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent('Quinocycle Sdn Bhd, No.13, Jalan Taming P/1, Taming Jaya, 43300 Balakong, Selangor, Malaysia');

const alternates = [
  { code: 'en', href: '/contact/' },
  { code: 'ms', href: '/ms/contact/' },
  { code: 'zh', href: '/zh/contact/' },
  { code: 'ja', href: '/ja/contact/' },
  { code: 'ko', href: '/ko/contact/' },
  { code: 'x-default', href: '/contact/' },
];
---

<Layout
  title={t.title}
  description={t.description}
  canonical={`/${locale}/contact/`}
  lang={t.lang}
  locale={locale}
  alternates={alternates}
>
  <section class="section">
    <div class="container">
      <span class="badge">{t.badge}</span>
      <h1 style="font-size:clamp(2rem,4vw,3rem);margin-bottom:1rem">{t.h1}</h1>
      <p style="color:#666;margin-bottom:2.5rem;line-height:1.7;max-width:640px">{t.intro}</p>

      <div class="contact-grid">
        <form id="enquiry-form" name="contact" class="contact-form">
          <p class="bot-field" aria-hidden="true">
            <label>Don't fill this out if you're human: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>
          <div class="form-group">
            <label for="name">{t.fName}</label>
            <input type="text" id="name" name="name" required />
          </div>
          <div class="form-group">
            <label for="company">{t.fCompany}</label>
            <input type="text" id="company" name="company" />
          </div>
          <div class="form-group">
            <label for="email">{t.fEmail}</label>
            <input type="email" id="email" name="email" required />
          </div>
          <div class="form-group">
            <label for="inquiry">{t.fInquiry}</label>
            <select id="inquiry" name="inquiry">
              <option value="sample">{t.inquiryOptions[0]}</option>
              <option value="quote">{t.inquiryOptions[1]}</option>
              <option value="technical">{t.inquiryOptions[2]}</option>
              <option value="other">{t.inquiryOptions[3]}</option>
            </select>
          </div>
          <div class="form-group">
            <label for="message">{t.fMessage}</label>
            <textarea id="message" name="message" rows="4"></textarea>
          </div>
          <button type="submit" class="btn btn--green" id="submit-btn" style="width:100%;justify-content:center">{t.submit}</button>
          <p class="form-note" id="form-note">
            {t.note}
            {t.notePrefer}
            <a href="mailto:sales@quinocycle.com" id="email-fallback" style="text-decoration:underline;font-weight:700">sales@quinocycle.com</a>
          </p>
          <p class="form-status" id="form-status" role="status" aria-live="polite" hidden data-ok={t.statusOk}></p>
        </form>

        <aside class="contact-info" aria-label="Contact details">
          <div class="contact-info__block">
            <h2 class="contact-info__heading">Quinocycle Sdn Bhd</h2>
            <p class="contact-info__ssm">SSM: 202001029919</p>
            <address class="contact-info__address">
              No.13, Jalan Taming P/1<br />
              Taming Jaya<br />
              43300 Balakong, Selangor,<br />
              Malaysia.
            </address>
            <a href={mapsUrl} target="_blank" rel="noopener" class="contact-info__directions">{t.directions}</a>
          </div>

          <div class="contact-info__block">
            <h3 class="contact-info__subheading">{t.reachUs}</h3>
            <ul class="contact-info__list">
              <li>
                <span class="contact-info__label">{t.whatsapp}</span>
                <a href="https://wa.me/60168916381" target="_blank" rel="noopener">+6016-891 6381</a>
              </li>
              <li>
                <span class="contact-info__label">{t.call}</span>
                <a href="tel:+60389626381">03-8962 6381</a>
              </li>
              <li>
                <span class="contact-info__label">{t.email}</span>
                <a href="mailto:sales@quinocycle.com">sales@quinocycle.com</a>
              </li>
            </ul>
          </div>

          <div class="contact-info__block">
            <h3 class="contact-info__subheading">{t.hours}</h3>
            <ul class="contact-info__hours">
              <li><span>{t.monFri}</span><span>9AM–5PM</span></li>
              <li><span>{t.sat}</span><span>9AM–1PM</span></li>
              <li><span>{t.sunHoliday}</span><span>{t.closed}</span></li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
    max-width: 1000px;
  }

  .contact-form { display: flex; flex-direction: column; gap: 1.25rem; }
  .bot-field { position: absolute; left: -9999px; opacity: 0; }
  .form-note { font-size: 0.8rem; color: #666; line-height: 1.6; }
  .form-status { font-size: 0.9rem; font-weight: 700; padding: 0.85rem 1rem; border: 2px solid #0a0a0a; }
  .form-status--ok { background: #39FF14; color: #0a0a0a; }
  .form-group { display: flex; flex-direction: column; gap: 0.4rem; }
  .form-group label { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .form-group input,
  .form-group select,
  .form-group textarea {
    border: 2px solid #0a0a0a;
    padding: 0.75rem 1rem;
    font-family: inherit;
    font-size: 0.9rem;
    background: #fff;
    transition: border-color 0.15s;
    width: 100%;
  }
  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: #39FF14;
  }

  .contact-info { border: 2px solid #0a0a0a; background: #f5f5f5; }
  .contact-info__block { padding: 1.75rem 2rem; border-bottom: 2px solid #0a0a0a; }
  .contact-info__block:last-child { border-bottom: none; }
  .contact-info__heading { font-size: 1.25rem; font-weight: 800; }
  .contact-info__ssm {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #666;
    margin: 0.25rem 0 1rem;
  }
  .contact-info__address { font-style: normal; font-size: 0.9rem; line-height: 1.7; color: #444; }
  .contact-info__directions {
    display: inline-block;
    margin-top: 1rem;
    font-weight: 700;
    font-size: 0.85rem;
    border-bottom: 2px solid #39FF14;
  }
  .contact-info__subheading {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .contact-info__list { list-style: none; display: flex; flex-direction: column; gap: 0.75rem; }
  .contact-info__list li { display: flex; align-items: baseline; gap: 0.75rem; font-size: 0.9rem; }
  .contact-info__label {
    flex-shrink: 0;
    width: 5.5rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #666;
  }
  .contact-info__list a { font-weight: 700; }
  .contact-info__list a:hover { border-bottom: 2px solid #39FF14; }
  .contact-info__hours { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }
  .contact-info__hours li { display: flex; justify-content: space-between; font-size: 0.9rem; color: #444; }
  .contact-info__hours li span:last-child { font-weight: 700; color: #0a0a0a; }

  @media (max-width: 768px) {
    .contact-grid { grid-template-columns: 1fr; gap: 2rem; }
    .contact-info { order: -1; }
  }
</style>

<script>
  const form = document.getElementById('enquiry-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('form-status') as HTMLElement | null;
  const emailFallback = document.getElementById('email-fallback') as HTMLAnchorElement | null;

  function buildWhatsAppText(data: FormData): string {
    const inquirySelect = document.getElementById('inquiry') as HTMLSelectElement | null;
    const inquiryLabel = inquirySelect?.selectedOptions[0]?.textContent ?? '';
    return [
      'New enquiry from paperhoneycombboard.com',
      '',
      `Name: ${data.get('name') || '-'}`,
      `Company: ${data.get('company') || '-'}`,
      `Email: ${data.get('email') || '-'}`,
      `Inquiry: ${inquiryLabel}`,
      '',
      `${data.get('message') || ''}`,
    ].join('\n').trim();
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form) return;
    const data = new FormData(form);
    if (data.get('bot-field')) return; // honeypot tripped — silently drop

    const text = buildWhatsAppText(data);
    const waUrl = `https://wa.me/60168916381?text=${encodeURIComponent(text)}`;
    const win = window.open(waUrl, '_blank', 'noopener');
    if (!win) window.location.href = waUrl;

    if (statusEl) {
      statusEl.hidden = false;
      statusEl.className = 'form-status form-status--ok';
      statusEl.textContent = statusEl.dataset.ok ?? '✓';
    }
  });

  form?.addEventListener('input', () => {
    if (!emailFallback || !form) return;
    const subject = encodeURIComponent('Website enquiry – Paper Honeycomb Board sample kit');
    const body = encodeURIComponent(buildWhatsAppText(new FormData(form)));
    emailFallback.href = `mailto:sales@quinocycle.com?subject=${subject}&body=${body}`;
  });
</script>
