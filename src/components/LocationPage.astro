---
import Layout from '../layouts/Layout.astro';
import { locationBySlug, locations } from '../content/locations';
import { LOC_LOCALES, LOC_LANG, locPath, locHubPath, locPrefix, locTemplate } from '../content/locations/types';
import type { LocLocale } from '../content/locations/types';

interface Props { slug: string; locale: LocLocale; }
const { slug, locale } = Astro.props;

const loc = locationBySlug(slug)!;
const c = loc.i18n[locale];
const t = locTemplate[locale];
const site = 'https://www.paperhoneycombboard.com';
const prefix = locPrefix(locale);

const faqs = [c.faq, ...t.sharedFaq(c.name)];
const nearby = loc.nearby.map((s) => locations.find((l) => l.slug === s)).filter(Boolean);

const alternates = [
  ...LOC_LOCALES.map((l) => ({ code: l, href: locPath(l, slug) })),
  { code: 'x-default', href: locPath('en', slug) },
];

const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'phb Paper Honeycomb Board – Quinocycle Sdn Bhd',
  description: t.descFor(c.name, c.industries.join(', ')),
  url: `${site}${locPath(locale, slug)}`,
  telephone: '+60389626381',
  email: 'sales@quinocycle.com',
  image: `${site}/og-default.jpg`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'No.13, Jalan Taming P/1, Taming Jaya',
    addressLocality: 'Balakong',
    postalCode: '43300',
    addressRegion: 'Selangor',
    addressCountry: 'MY',
  },
  areaServed: { '@type': 'Place', name: c.name },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: LOC_LANG[locale],
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}${prefix}/` },
    { '@type': 'ListItem', position: 2, name: t.hubTitle, item: `${site}${locHubPath(locale)}` },
    { '@type': 'ListItem', position: 3, name: c.name },
  ],
};
---

<Layout
  title={t.titleFor(c.name)}
  description={t.descFor(c.name, c.industries.join(', '))}
  canonical={locPath(locale, slug)}
  ogImage={loc.image.startsWith('http') ? loc.image : loc.image}
  lang={LOC_LANG[locale]}
  locale={locale}
  alternates={alternates}
  schema={businessSchema}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />

  <section class="loc-hero">
    <div class="loc-hero__media" style={`--bg:url('${loc.image}')`} aria-hidden="true"></div>
    <div class="container loc-hero__inner">
      <a href={locHubPath(locale)} class="loc-hero__back">&larr; {t.backToHub}</a>
      <h1 class="loc-hero__title">{t.h1For(c.name)}</h1>
      <p class="loc-hero__blurb">{c.blurb}</p>
    </div>
  </section>

  <section class="section loc-body">
    <div class="container loc-grid">
      <div class="loc-main">
        <div class="loc-panel">
          <h2>{t.areasLabel}</h2>
          <ul class="loc-chips">
            {loc.areas.map((a) => <li>{a}</li>)}
          </ul>
        </div>

        <div class="loc-panel">
          <h2>{t.industriesLabel}</h2>
          <ul class="loc-chips loc-chips--green">
            {c.industries.map((i) => <li>{i}</li>)}
          </ul>
        </div>

        <div class="loc-panel">
          <h2>{t.whyLabel}</h2>
          <p class="loc-usecase">{c.useCase}</p>
          <p class="loc-whyintro">{t.whyIntro(c.name)}</p>
          <div class="loc-benefits">
            {t.benefits.map((b, i) => (
              <div class="loc-benefit">
                <span class="loc-benefit__num">0{i + 1}</span>
                <div>
                  <strong>{b.h}</strong>
                  <p>{b.p}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="loc-panel">
          <h2>{t.faqLabel}</h2>
          <div class="faq-list">
            {faqs.map((f) => (
              <details class="faq-item">
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </div>

      <aside class="loc-side">
        <div class="loc-card loc-card--delivery">
          <h3>{t.deliveryLabel}</h3>
          <p>{c.delivery}</p>
        </div>

        <div class="loc-card">
          <h3>{t.productsLabel}</h3>
          <ul class="loc-products">
            {t.products.map((p) => (
              <li>
                <a href={p.href}>{p.label}</a>
                <p>{p.blurb}</p>
              </li>
            ))}
          </ul>
        </div>

        {nearby.length > 0 && (
          <div class="loc-card">
            <h3>{t.nearbyLabel}</h3>
            <ul class="loc-nearby">
              {nearby.map((n) => (
                <li><a href={locPath(locale, n!.slug)}>{n!.i18n[locale].name}</a></li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </section>

  <section class="loc-cta">
    <div class="container">
      <h2>{t.ctaTitle(c.name)}</h2>
      <p>{t.ctaText}</p>
      <div class="cta-block__actions">
        <a href={`${prefix}/contact/`} class="btn btn--dark">{t.ctaPrimary}</a>
        <a href="https://wa.me/60168916381" target="_blank" rel="noopener" class="btn btn--outline">{t.ctaSecondary}</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .loc-hero { position: relative; background: var(--black); overflow: hidden; }
  .loc-hero__media {
    position: absolute;
    inset: 0;
    background-image: var(--bg);
    background-size: cover;
    background-position: center;
    opacity: 0.35;
  }
  .loc-hero__inner { position: relative; padding: 4rem 2rem 3.5rem; color: var(--white); max-width: 820px; }
  .loc-hero__back {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-bottom: 2px solid #39FF14;
    padding-bottom: 2px;
  }
  .loc-hero__title {
    font-size: clamp(1.9rem, 4.5vw, 3.3rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 1.1rem 0 1rem;
  }
  .loc-hero__blurb { color: rgba(255, 255, 255, 0.85); line-height: 1.8; }

  .loc-grid { display: grid; grid-template-columns: 1.7fr 1fr; gap: 2.5rem; align-items: start; }
  .loc-panel { margin-bottom: 2.5rem; }
  .loc-panel h2 {
    font-size: 1.15rem;
    font-weight: 800;
    padding-bottom: 0.6rem;
    border-bottom: 2px solid #0a0a0a;
    margin-bottom: 1.1rem;
  }
  .loc-chips { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .loc-chips li {
    border: 2px solid #0a0a0a;
    padding: 0.35rem 0.8rem;
    font-size: 0.78rem;
    font-weight: 700;
  }
  .loc-chips--green li { background: #39FF14; border-color: #0a0a0a; }

  .loc-usecase { line-height: 1.85; color: #333; margin-bottom: 1rem; }
  .loc-whyintro { line-height: 1.8; color: #666; font-size: 0.92rem; margin-bottom: 1.25rem; }
  .loc-benefits { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; }
  .loc-benefit { display: flex; gap: 0.8rem; align-items: flex-start; }
  .loc-benefit__num {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #0a0a0a;
    color: #39FF14;
    font-weight: 800;
    font-size: 0.75rem;
  }
  .loc-benefit strong { display: block; font-size: 0.9rem; margin-bottom: 0.25rem; }
  .loc-benefit p { font-size: 0.82rem; color: #666; line-height: 1.6; }

  .faq-list { display: flex; flex-direction: column; }
  .faq-item { border-top: 1px solid #ddd; }
  .faq-item:first-child { border-top: none; }
  .faq-item summary {
    padding: 1rem 0;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-size: 0.92rem;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; font-size: 1.35rem; font-weight: 300; }
  .faq-item[open] summary::after { content: '\2212'; }
  .faq-item p { padding-bottom: 1rem; color: #444; line-height: 1.75; font-size: 0.9rem; }

  .loc-side { display: flex; flex-direction: column; gap: 1.25rem; position: sticky; top: 84px; }
  .loc-card { border: 2px solid #0a0a0a; padding: 1.4rem 1.5rem; background: #fff; }
  .loc-card--delivery { background: #39FF14; }
  .loc-card h3 {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }
  .loc-card p { font-size: 0.88rem; line-height: 1.7; }
  .loc-products { list-style: none; display: flex; flex-direction: column; gap: 0.9rem; }
  .loc-products a { font-weight: 800; font-size: 0.9rem; border-bottom: 2px solid #39FF14; }
  .loc-products p { font-size: 0.8rem; color: #666; margin-top: 0.2rem; }
  .loc-nearby { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .loc-nearby a {
    display: inline-block;
    border: 1px solid #ccc;
    padding: 0.3rem 0.7rem;
    font-size: 0.78rem;
    font-weight: 700;
  }
  .loc-nearby a:hover { border-color: #0a0a0a; }

  .loc-cta { background: var(--black); color: var(--white); text-align: center; padding: 4rem 0; }
  .loc-cta h2 { font-size: clamp(1.6rem, 3.5vw, 2.5rem); font-weight: 900; margin-bottom: 0.75rem; }
  .loc-cta p { color: #aaa; max-width: 560px; margin: 0 auto 1.75rem; line-height: 1.7; }

  @media (max-width: 900px) {
    .loc-grid { grid-template-columns: 1fr; }
    .loc-side { position: static; }
    .loc-benefits { grid-template-columns: 1fr; }
  }
</style>
