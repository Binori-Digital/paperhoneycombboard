---
interface Props { locale?: string; }
const { locale = 'en' } = Astro.props;

// Nav labels per language
// Nav labels are kept short so the bar never wraps; the full phrases live
// on the pages themselves.
const navText: Record<string, { links: string[]; cta: string }> = {
  en: { links: ['Solutions', 'Eco-Lab', 'Combat Zone', 'Regional', 'Story', 'Contact'], cta: 'Get a Sample Kit' },
  ms: { links: ['Penyelesaian', 'Eco-Lab', 'Perbandingan', 'Serantau', 'Cerita', 'Hubungi'], cta: 'Kit Sampel' },
  zh: { links: ['解决方案', '环保实验室', '材料对比', '区域服务', '案例故事', '联系我们'], cta: '索取样品套装' },
  ja: { links: ['ソリューション', 'エコラボ', '素材比較', '地域展開', 'ストーリー', 'お問い合わせ'], cta: 'サンプル請求' },
  ko: { links: ['솔루션', '에코랩', '소재 비교', '지역 서비스', '스토리', '문의하기'], cta: '샘플 신청' },
};
const t = navText[locale] ?? navText.en;

// Home + contact are translated; other pages exist in English only
const prefix = locale === 'en' ? '' : '/' + locale;
const homeHref = prefix + '/';
const navLinks = [
  { href: homeHref, label: t.links[0] },
  { href: '/honeycomb-panels/', label: t.links[1] },
  { href: '/honeycomb-board-vs-plywood/', label: t.links[2] },
  { href: '/regional/', label: t.links[3] },
  { href: prefix + '/story/', label: t.links[4] },
  { href: prefix + '/contact/', label: t.links[5] },
];
const ctaHref = prefix + '/contact/';

const path = Astro.url?.pathname ?? '';
// Path without any locale prefix, for language switching
const basePath = path.replace(/^\/(ms|zh|ja|ko)(?=\/|$)/, '') || '/';
// Pages that exist in every language — including all /story/ articles.
const translatedPaths = ['/', '/contact/', '/story/'];
const isTranslated = translatedPaths.includes(basePath) || basePath.startsWith('/story/');
const langHref = (code: string) => {
  const target = isTranslated ? basePath : '/';
  return code === 'en' ? target : '/' + code + target;
};

const languages = [
  { code: 'en', label: 'English', flag: 'my' },
  { code: 'ms', label: 'Bahasa Malaysia', flag: 'my' },
  { code: 'zh', label: '中文', flag: 'my' },
  { code: 'ja', label: '日本語', flag: 'jp' },
  { code: 'ko', label: '한국어', flag: 'kr' },
];
const current = languages.find(l => l.code === locale) ?? languages[0];
const shortLabel: Record<string, string> = { en: 'EN', ms: 'BM', zh: '中文', ja: 'JA', ko: 'KO' };
---

<header class="nav">
  <div class="container nav__inner">
    <a href={homeHref} class="nav__logo" aria-label="PHB - Paper Honeycomb Board">phb.</a>
    <nav aria-label="Main navigation">
      <ul class="nav__links">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class:list={['nav__link', { 'nav__link--active': path === link.href || (link.href !== '/' && path.startsWith(link.href)) }]}
            >
              {link.label}
            </a>
          </li>
        ))}
        <li class="nav__item--cta">
          <a href={ctaHref} class="btn btn--green">{t.cta}</a>
        </li>
      </ul>
    </nav>

    <details class="lang" id="lang-menu">
      <summary class="lang__current" aria-label="Select language">
        <span class="flag" aria-hidden="true">
          {current.flag === 'my' && (
            <svg viewBox="0 0 24 24"><defs><clipPath id="cf-my-cur"><circle cx="12" cy="12" r="12"/></clipPath></defs><g clip-path="url(#cf-my-cur)"><rect width="24" height="24" fill="#fff"/><g fill="#cc0001"><rect y="0" width="24" height="1.75"/><rect y="3.5" width="24" height="1.75"/><rect y="7" width="24" height="1.75"/><rect y="10.5" width="24" height="1.75"/><rect y="14" width="24" height="1.75"/><rect y="17.5" width="24" height="1.75"/><rect y="21" width="24" height="1.75"/></g><rect width="13" height="12.25" fill="#010066"/><circle cx="5.5" cy="6" r="3.1" fill="#fc0"/><circle cx="6.7" cy="6" r="2.6" fill="#010066"/><path fill="#fc0" d="M10.2 6l1.9.44-1.86.55 1.19 1.54-1.7-.95-.48 1.86-.47-1.86-1.7.95 1.19-1.54L6.4 6.44 8.3 6l-1.9-.44 1.87-.55-1.19-1.54 1.7.95.47-1.86.48 1.86 1.7-.95-1.19 1.54 1.86.55z"/></g></svg>
          )}
          {current.flag === 'jp' && (
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="12" fill="#fff"/><circle cx="12" cy="12" r="11.5" fill="none" stroke="#e5e5e5"/><circle cx="12" cy="12" r="6" fill="#bc002d"/></svg>
          )}
          {current.flag === 'kr' && (
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="12" fill="#fff"/><circle cx="12" cy="12" r="11.5" fill="none" stroke="#e5e5e5"/><path d="M6 12a6 6 0 0 1 12 0z" fill="#cd2e3a"/><path d="M18 12a6 6 0 0 1-12 0z" fill="#0047a0"/><circle cx="9" cy="12" r="3" fill="#cd2e3a"/><circle cx="15" cy="12" r="3" fill="#0047a0"/></svg>
          )}
        </span>
        <span class="lang__code">{shortLabel[locale]}</span>
        <span class="lang__chevron" aria-hidden="true">▾</span>
      </summary>
      <ul class="lang__list">
        {languages.map(l => (
          <li>
            <a href={langHref(l.code)} class:list={['lang__option', { 'lang__option--active': l.code === locale }]} hreflang={l.code} lang={l.code}>
              <span class="flag" aria-hidden="true">
                {l.flag === 'my' && (
                  <svg viewBox="0 0 24 24"><defs><clipPath id={'cf-my-' + l.code}><circle cx="12" cy="12" r="12"/></clipPath></defs><g clip-path={'url(#cf-my-' + l.code + ')'}><rect width="24" height="24" fill="#fff"/><g fill="#cc0001"><rect y="0" width="24" height="1.75"/><rect y="3.5" width="24" height="1.75"/><rect y="7" width="24" height="1.75"/><rect y="10.5" width="24" height="1.75"/><rect y="14" width="24" height="1.75"/><rect y="17.5" width="24" height="1.75"/><rect y="21" width="24" height="1.75"/></g><rect width="13" height="12.25" fill="#010066"/><circle cx="5.5" cy="6" r="3.1" fill="#fc0"/><circle cx="6.7" cy="6" r="2.6" fill="#010066"/><path fill="#fc0" d="M10.2 6l1.9.44-1.86.55 1.19 1.54-1.7-.95-.48 1.86-.47-1.86-1.7.95 1.19-1.54L6.4 6.44 8.3 6l-1.9-.44 1.87-.55-1.19-1.54 1.7.95.47-1.86.48 1.86 1.7-.95-1.19 1.54 1.86.55z"/></g></svg>
                )}
                {l.flag === 'jp' && (
                  <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="12" fill="#fff"/><circle cx="12" cy="12" r="11.5" fill="none" stroke="#e5e5e5"/><circle cx="12" cy="12" r="6" fill="#bc002d"/></svg>
                )}
                {l.flag === 'kr' && (
                  <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="12" fill="#fff"/><circle cx="12" cy="12" r="11.5" fill="none" stroke="#e5e5e5"/><path d="M6 12a6 6 0 0 1 12 0z" fill="#cd2e3a"/><path d="M18 12a6 6 0 0 1-12 0z" fill="#0047a0"/><circle cx="9" cy="12" r="3" fill="#cd2e3a"/><circle cx="15" cy="12" r="3" fill="#0047a0"/></svg>
                )}
              </span>
              <span>{l.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </details>

    <a href={ctaHref} class="btn btn--green nav__cta">{t.cta}</a>
    <button class="nav__burger" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #fff;
    border-bottom: 2px solid #0a0a0a;
  }
  .nav__inner {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 1.8vw, 2rem);
    min-height: 64px;
    flex-wrap: nowrap;
  }
  .nav__logo {
    font-size: 1.5rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    flex-shrink: 0;
    margin-right: auto;
    line-height: 1;
  }
  .nav__links {
    display: flex;
    list-style: none;
    align-items: center;
    gap: clamp(0.85rem, 1.5vw, 1.6rem);
    flex-wrap: nowrap;
  }
  .nav__link {
    display: block;
    font-size: clamp(0.66rem, 0.78vw, 0.74rem);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
    color: #666;
    padding-bottom: 2px;
    border-bottom: 2px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }
  .nav__link:hover { color: #0a0a0a; }
  .nav__link--active { color: #0a0a0a; border-bottom-color: #0a0a0a; }

  .nav__cta {
    flex-shrink: 0;
    padding: 0.55rem 1.1rem;
    font-size: 0.66rem;
    white-space: nowrap;
    line-height: 1.1;
  }
  .nav__item--cta { display: none; }

  .nav__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    padding: 6px 4px;
    cursor: pointer;
    flex-shrink: 0;
  }
  .nav__burger span {
    display: block;
    width: 22px;
    height: 2px;
    background: #0a0a0a;
    transition: transform 0.2s, opacity 0.2s;
  }
  .nav__burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav__burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .nav__burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* ===== Language selector ===== */
  .lang { position: relative; flex-shrink: 0; }
  .lang__current {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
    list-style: none;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.35rem 0.5rem;
    border: 2px solid #0a0a0a;
    background: #fff;
    user-select: none;
  }
  .lang__current::-webkit-details-marker { display: none; }
  .lang__chevron { font-size: 0.6rem; }
  .lang[open] .lang__chevron { transform: rotate(180deg); }
  .flag { display: inline-flex; width: 20px; height: 20px; flex-shrink: 0; }
  .flag svg { width: 100%; height: 100%; display: block; }
  .lang__list {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    min-width: 190px;
    background: #fff;
    border: 2px solid #0a0a0a;
    list-style: none;
    z-index: 200;
    box-shadow: 4px 4px 0 rgba(10, 10, 10, 0.15);
  }
  .lang__option {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.85rem;
    font-size: 0.8rem;
    font-weight: 600;
    transition: background 0.1s;
  }
  .lang__option:hover { background: #f5f5f5; }
  .lang__option--active { background: #39FF14; }
  .lang__list li + li { border-top: 1px solid #e5e5e5; }

  /* Mid widths: drop the CTA button, keep the full link row */
  @media (max-width: 1180px) {
    .nav__cta { display: none; }
  }

  /* Narrow: collapse the links into a drawer */
  @media (max-width: 940px) {
    .nav__logo { margin-right: 0; }
    .lang { margin-left: auto; }
    .nav__burger { display: flex; }

    .nav__links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: #fff;
      border-bottom: 2px solid #0a0a0a;
      box-shadow: 0 10px 20px rgba(10, 10, 10, 0.08);
      padding: 0.5rem 0 1rem;
    }
    .nav__links--open { display: flex; }
    .nav__links li { border-top: 1px solid #eee; }
    .nav__links li:first-child { border-top: none; }
    .nav__link {
      font-size: 0.82rem;
      padding: 0.95rem 2rem;
      border-bottom: none;
      color: #0a0a0a;
    }
    .nav__link--active {
      color: #0a0a0a;
      box-shadow: inset 4px 0 0 #39FF14;
    }

    /* CTA lives inside the drawer at this size */
    .nav__item--cta { display: block; border-top: 1px solid #eee; padding: 1rem 2rem 0.25rem; }
    .nav__item--cta .btn { display: block; text-align: center; font-size: 0.7rem; }
  }

  @media (max-width: 480px) {
    .nav__link { padding-left: 1rem; padding-right: 1rem; }
    .nav__item--cta { padding-left: 1rem; padding-right: 1rem; }
    .lang__code { display: none; }
  }
</style>

<script>
  const burger = document.querySelector('.nav__burger') as HTMLButtonElement | null;
  const navLinks = document.querySelector('.nav__links') as HTMLElement | null;
  const lang = document.getElementById('lang-menu') as HTMLDetailsElement | null;

  const setMenu = (open: boolean) => {
    burger?.setAttribute('aria-expanded', String(open));
    navLinks?.classList.toggle('nav__links--open', open);
  };

  burger?.addEventListener('click', (e) => {
    e.stopPropagation();
    setMenu(burger.getAttribute('aria-expanded') !== 'true');
    if (lang) lang.open = false;
  });

  // Opening the language menu closes the nav drawer, and vice versa
  lang?.addEventListener('toggle', () => {
    if (lang.open) setMenu(false);
  });

  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    if (lang?.open && !lang.contains(target)) lang.open = false;
    if (navLinks?.classList.contains('nav__links--open') && !navLinks.contains(target) && !burger?.contains(target)) {
      setMenu(false);
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    setMenu(false);
    if (lang) lang.open = false;
  });

  // Reset state when resizing back up to the desktop layout
  window.addEventListener('resize', () => {
    if (window.innerWidth > 940) setMenu(false);
  }, { passive: true });
</script>
