    },
    {
      "@type": "Question",
      "name": "Is honeycomb board recyclable?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes — 100%. Honeycomb board is kraft paper and water-based adhesive, so it goes into the standard paper recycling stream. Unlike wood (usually landfilled) or plastic pallets (specialised recycling only), disposal at destination is free and clean." }
    },
    {
      "@type": "Question",
      "name": "What is honeycomb board used for?",
      "acceptedAnswer": { "@type": "Answer", "text": "Main uses: paper pallets, heavy-duty export crates and boxes, protective packaging (edge protectors, corner blocks, void fill, cushioning), furniture cores (most flat-pack furniture uses honeycomb cores), doors, retail and exhibition displays, and lightweight architectural panels." }
    }
  ]
