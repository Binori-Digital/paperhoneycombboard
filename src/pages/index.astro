---
import Layout from '../layouts/Layout.astro';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is ISPM-15 exempt paper honeycomb board?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Paper honeycomb boards are biologically inert and naturally exempt from ISPM-15 phytosanitary regulations. Unlike wood pallets, they require no heat treatment or fumigation, enabling seamless international shipping."
      }
    },
    {
      "@type": "Question",
      "name": "How much weight can you save with paper honeycomb vs plywood?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A standard phb paper honeycomb pallet weighs approximately 5kg vs 25kg for plywood — saving 20kg per pallet. At a typical $4.50/kg air freight rate, that is around $90 in freight savings per pallet, or $45,000 on a 500-pallet shipment."
      }
    },
    {
      "@type": "Question",
      "name": "Where is phb paper honeycomb board available in Malaysia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "phb maintains KL logistics hub stock in Kuala Lumpur with JIT delivery to Shah Alam, Petaling Jaya, Klang Valley, and Johor Bahru. Direct routes to Port Klang (North and West Ports) are available daily."
      }
    },
    {
      "@type": "Question",
      "name": "Is paper honeycomb board 100% recyclable?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. phb paper honeycomb is 100% curbside recyclable. Unlike plastic (limited/specialized recycling) or plywood (difficult/landfill), it meets stringent ESG environmental labeling standards perfect for MNCs in industrial zones."
      }
    }
  ]
};

// Industry pain points — sources: USDA interception data 2025, Montreal
// Protocol methyl bromide restrictions, EU PPWR (in force Aug 2026)
const pains = [
  {
    img: 'https://images.unsplash.com/photo-1494412574643-ff11b0a5c1c3?w=1600&q=70',
    title: 'Rejected at the Border',
    text: 'US customs intercepted 24,000+ non-compliant wood packaging shipments in 2025. Fumigation is restricted in 47 countries — one missing ISPM-15 stamp strands your cargo.',
    solution: 'Paper honeycomb is ISPM-15 exempt by nature. No treatment, no stamps, no rejections.',
  },
  {
    img: 'https://images.unsplash.com/photo-1529107386315-e1a2ed48a620?w=1600&q=70',
    title: 'The Regulation Wave Has Landed',
    text: "The EU's PPWR is now in force: recyclability mandates, EPR fees, plastic taxes, foam bans. Non-compliant packaging has become a growing cost line.",
    solution: '100% curbside-recyclable kraft — one material, zero packaging-waste liability.',
  },
  {
    img: 'https://images.unsplash.com/photo-1436491865332-7a61a109cc05?w=1600&q=70',
    title: 'Paying Freight on Dead Weight',
    text: 'A 25kg wooden pallet is billed like cargo. Multiply by hundreds of shipments a month, and tare weight quietly eats your margin.',
    solution: '~5kg per pallet — up to 80% lighter, saving around RM400 per air pallet.',
  },
  {
    img: 'https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=1600&q=70',
    title: "Timber You Can't Trust",
    text: 'Lumber prices swing with every cycle. Boards warp, absorb moisture, grow mold, jam automated lines, and splinter into cargo claims.',
    solution: 'Engineered paper cores — consistent dimensions, no nails, no mold, stable supply.',
  },
  {
    img: 'https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=1600&q=70',
    title: 'Heavy Packaging Hurts People',
    text: 'Two-person lifts and strain injuries at your dock — then your customer pays to landfill the crate at theirs.',
    solution: 'One-person handling at ~5kg. Disposal is simply paper recycling.',
  },
];

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "phb Paper Honeycomb Board",
  "description": "Industrial-grade hexagonal honeycomb board for packaging, pallets, and creative structures. ISPM-15 exempt, 100% recyclable, up to 80% lighter than wood pallets.",
  "brand": { "@type": "Brand", "name": "phb" },
  "manufacturer": {
    "@type": "Organization",
    "name": "phb Paper Honeycomb Board",
    "address": { "@type": "PostalAddress", "addressLocality": "Johor Bahru", "addressCountry": "MY" }
  },
  "offers": {
    "@type": "Offer",
    "price": 0,
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock",
    "url": "https://www.paperhoneycombboard.com/#contact",
    "description": "Custom quote — contact for pricing."
  }
};
---

<Layout
  title="Paper Honeycomb Board Manufacturer Malaysia | phb"
  description="Paper honeycomb board manufacturer in Malaysia. ISPM-15 exempt honeycomb boards, boxes & pallets — up to 80% lighter than wood, saving up to $90 per pallet on air freight. Get a sample kit."
  canonical="/"
  schema={productSchema}
  alternates={[
    { code: 'en', href: '/' },
    { code: 'ms', href: '/ms/' },
    { code: 'zh', href: '/zh/' },
    { code: 'ja', href: '/ja/' },
    { code: 'ko', href: '/ko/' },
    { code: 'x-default', href: '/' },
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <!-- HERO (scroll-scrubbed animated) -->
  <section class="hero" id="hero" aria-labelledby="hero-heading">
    <div class="hero__stage">
      <video
        class="hero__video"
        src="/media/hero-morph.mp4"
        poster="/media/hero-poster.jpg"
        muted
        loop
        autoplay
        playsinline
        preload="metadata"
        aria-hidden="true"
      ></video>
      <div class="hero__scrim" aria-hidden="true"></div>

      <div class="container hero__overlay">
        <span class="badge badge--peach">Industrial Structural Integrity</span>
        <h1 class="hero__title" id="hero-heading">The Future is<br />Honeycomb Board</h1>
        <p class="hero__desc">
          Ditch the wood. ISPM-15 exempt paper honeycomb solutions — up to 80% lighter than
          wood pallets. Heavyweight protection, featherweight footprint.
        </p>
        <div class="hero__actions">
          <a href="#calculator" class="btn btn--green">Calculate My Savings</a>
          <a href="/honeycomb-board-vs-plywood/" class="btn btn--outline-white">View Specs</a>
        </div>
      </div>

      <div class="hero__hud" aria-hidden="true">
        <span class="hero__hud-label" data-hero-caption>Flat honeycomb board</span>
        <div class="hero__progress"><span class="hero__progress-bar"></span></div>
      </div>

      <div class="hero__scroll-cue" aria-hidden="true">
        <span>Scroll to assemble</span>
        <span class="hero__scroll-arrow">↓</span>
      </div>
    </div>
  </section>

  <!-- STATS BAR -->
  <div class="stats-bar" role="region" aria-label="Key performance statistics">
    <div class="container stats-bar__inner">
      <div class="stat-box">
        <div class="stat-box__value">80%</div>
        <div class="stat-box__label">Lighter Than Wood Pallets</div>
      </div>
      <div class="stat-box">
        <div class="stat-box__value">$90</div>
        <div class="stat-box__label">Air Freight Saved / Pallet</div>
      </div>
      <div class="stats-bar__divider" aria-hidden="true"></div>
      <div>
        <p class="stats-bar__brands-label">Built for Demanding Industries</p>
        <div class="stats-bar__brands">
          <span>Electronics</span>
          <span>Furniture</span>
          <span>Logistics</span>
        </div>
      </div>
    </div>
  </div>

  <!-- INDUSTRY PAIN POINTS -->
  <section class="section pains-section" aria-labelledby="pains-heading">
    <div class="container pains-header">
      <span class="badge">The State of the Industry</span>
      <h2 id="pains-heading" class="pains-title">Five Problems Draining<br />Conventional Supply Chains</h2>
      <p class="pains-sub">
        If you ship on wood, plastic, or foam, you're fighting all five — every single day.
        We built phb to end them.
      </p>
    </div>
    <div class="pains">
      {pains.map((p, i) => (
        <article class="pain-band" style={`--bg:url('${p.img}')`}>
          <span class="pain-band__num" aria-hidden="true">0{i + 1}</span>
          <div class="container pain-band__inner">
            <h3 class="pain-band__title">{p.title}</h3>
            <p class="pain-band__text">{p.text}</p>
          </div>
        </article>
      ))}
    </div>
    <div class="pains-closer">
      <div class="container">
        <span class="badge badge--dark">The phb Answer</span>
        <h3 class="pains-closer__title">Five Problems.<br />One Material. Solved.</h3>
        <ul class="pains-closer__list">
          {pains.map((p, i) => (
            <li>
              <span class="pains-closer__num" aria-hidden="true">0{i + 1}</span>
              <div>
                <strong>{p.title}</strong>
                <p>{p.solution}</p>
              </div>
            </li>
          ))}
        </ul>
        <div class="cta-block__actions">
          <a href="/contact/" class="btn btn--dark">Get a Sample Kit</a>
          <a href="/paper-honeycomb-board-guide/" class="btn btn--outline">Read the Complete Guide</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FUMIGATION FEATURE -->
  <section class="section" aria-labelledby="fumigation-heading">
    <div class="container feature-row">
      <div class="feature-row__img">
        <img
          src="https://images.unsplash.com/photo-1553413077-190dd305871c?w=700&q=80"
          alt="Pallets stacked in an industrial warehouse"
          width="600" height="400"
          loading="lazy"
        />
      </div>
      <div class="feature-row__content">
        <h2 id="fumigation-heading">The Fumigation<br />Headache is Over.</h2>
        <div class="feature-card feature-card--peach" style="margin-top:1.5rem">
          <h3 class="feature-card__title">The No-Paperwork Solution</h3>
          <p class="feature-card__text">
            Our materials are ISPM-15 exempt by design. No fumigation, no stamps, no border delays.
            Just seamless transit for your high-value assets.
          </p>
        </div>
        <div class="compliance-row">
          <div class="feature-card__icon">📋</div>
          <div>
            <strong>Automated Compliance</strong>
            <p>Certifications are pre-baked into the material properties of every unit.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WEIGHT SAVINGS CALCULATOR -->
  <section class="section section--dark" id="calculator" aria-labelledby="calc-heading">
    <div class="container calc-grid">
      <div>
        <h2 id="calc-heading" class="calc-title">Weight Savings<br />Calculator</h2>
        <p class="calc-desc">
          Each phb pallet weighs ~5kg vs ~25kg for wood — 20kg less tare weight per pallet.
          Enter your monthly pallet volume and freight rate to see the estimated air-freight saving.
        </p>
        <a href="/contact/" class="btn btn--green">Open Widget</a>
      </div>
      <div class="calc-widget" role="form" aria-label="Weight savings calculator">
        <label for="currency">Currency</label>
        <select id="currency">
          <option value="RM" selected>RM – Malaysian Ringgit</option>
          <option value="USD">USD – US Dollar</option>
        </select>
        <label for="pallets">Pallets Shipped per Month</label>
        <input type="number" id="pallets" placeholder="e.g. 250" min="1" />
        <label for="rate">Air Freight Rate (per KG)</label>
        <input type="number" id="rate" placeholder="e.g. 20.00" min="0" step="0.1" value="20.00" />
        <div class="calc-widget__result">
          <span class="calc-widget__result-label">Estimated Savings</span>
          <span class="calc-widget__result-value" id="savings-output">RM 0 / mo</span>
        </div>
      </div>
    </div>
  </section>

  <!-- INDUSTRY FOCUS -->
  <section class="section" aria-labelledby="industry-heading">
    <div class="container">
      <div class="industry-header">
        <div>
          <p class="badge">Verticals</p>
          <h2 id="industry-heading">Industry Focus</h2>
        </div>
        <a href="/honeycomb-panels/" class="btn btn--outline view-all">View All Solutions</a>
      </div>
      <div class="grid-3">
        <article class="feature-card">
          <div class="feature-card__icon" style="background:#F5C8A0">⚙️</div>
          <h3 class="feature-card__title">Electronics</h3>
          <p class="feature-card__text">
            Anti-static, shock-absorbent packaging for high-value components and microchips.
          </p>
          <a href="/honeycomb-panels/" class="explore-link">Explore →</a>
        </article>
        <article class="feature-card">
          <div class="feature-card__icon">🚛</div>
          <h3 class="feature-card__title">Logistics</h3>
          <p class="feature-card__text">
            Load-bearing pallets and void fillers designed for high-density global shipping.
          </p>
          <a href="/regional/" class="explore-link">Explore →</a>
        </article>
        <article class="feature-card feature-card--dark">
          <div class="feature-card__icon">🏗️</div>
          <h3 class="feature-card__title">Creative Lab</h3>
          <p class="feature-card__text">
            Custom engineering for displays, temporary furniture, and structural architectural prototypes.
          </p>
          <a href="/honeycomb-panels/" class="explore-link" style="color:#39FF14">Explore →</a>
        </article>
      </div>
    </div>
  </section>

  <!-- FAQ SECTION (AEO optimisation) -->
  <section class="section faq-section" aria-labelledby="faq-heading">
    <div class="container faq-container">
      <h2 id="faq-heading">Frequently Asked Questions</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary>What is ISPM-15 exempt paper honeycomb board?</summary>
          <p>Paper honeycomb boards are biologically inert and naturally exempt from ISPM-15 phytosanitary regulations. Unlike wood pallets, they require no heat treatment or fumigation — enabling seamless international shipping from Malaysia and Singapore.</p>
        </details>
        <details class="faq-item">
          <summary>How much weight can you save vs plywood?</summary>
          <p>A standard phb paper honeycomb pallet weighs ~5kg vs 25kg for plywood — saving 20kg per pallet. At a typical $4.50/kg air freight rate, that's around $90 in freight savings per pallet, or $45,000 on a 500-pallet shipment.</p>
        </details>
        <details class="faq-item">
          <summary>Where is phb available in Malaysia?</summary>
          <p>We maintain KL hub stock with JIT delivery to Shah Alam, Petaling Jaya, Klang Valley, and Johor Bahru. Direct routes to Port Klang (North &amp; West Ports) available daily.</p>
        </details>
        <details class="faq-item">
          <summary>Is paper honeycomb board 100% recyclable?</summary>
          <p>Yes. phb paper honeycomb is 100% curbside recyclable with Kraft paper construction. It meets stringent ESG environmental labeling standards — ideal for ESG-focused MNCs in industrial zones.</p>
        </details>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ===== ANIMATED SCROLL HERO ===== */
  .hero {
    position: relative;
    padding: 0;
    background: var(--black);
  }
  .hero__stage {
    position: relative;
    height: 100vh;
    min-height: 560px;
    overflow: hidden;
    display: flex;
    align-items: center;
  }
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(90deg, rgba(10,10,10,0.88) 0%, rgba(10,10,10,0.55) 45%, rgba(10,10,10,0.12) 100%),
      linear-gradient(0deg, rgba(10,10,10,0.55) 0%, rgba(10,10,10,0) 45%);
  }
  .hero__overlay {
    position: relative;
    z-index: 2;
    width: 100%;
    color: var(--white);
  }
  .hero__overlay .hero__title {
    color: var(--white);
    font-size: clamp(2.5rem, 6vw, 5rem);
    margin-bottom: 1.25rem;
  }
  .hero__overlay .hero__desc { color: rgba(255,255,255,0.82); max-width: 480px; }

  /* HUD + progress (shown in scroll-scrub mode) */
  .hero__hud {
    position: absolute;
    z-index: 2;
    right: 2rem;
    bottom: 2rem;
    display: none;
    align-items: center;
    gap: 0.75rem;
    color: var(--white);
  }
  .hero__hud-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: rgba(10,10,10,0.55);
    border: 1px solid rgba(255,255,255,0.3);
    padding: 0.4rem 0.7rem;
  }
  .hero__progress { width: 120px; height: 3px; background: rgba(255,255,255,0.22); }
  .hero__progress-bar {
    display: block;
    height: 100%;
    width: calc(var(--p, 0) * 100%);
    background: var(--green);
  }

  .hero__scroll-cue {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: 1.5rem;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    color: var(--white);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: calc(1 - var(--p, 0) * 3);
    pointer-events: none;
  }
  .hero__scroll-arrow { font-size: 1rem; animation: hero-bob 1.6s ease-in-out infinite; }
  @keyframes hero-bob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(5px); } }

  /* Scroll-scrub mode — enabled by JS on capable viewports */
  .hero--scroll { height: 300vh; }
  .hero--scroll .hero__stage { position: sticky; top: 0; }
  .hero--scroll .hero__hud { display: flex; }
  .hero--scroll .hero__overlay {
    transform: translateY(calc(var(--p, 0) * -28px));
    opacity: calc(1 - var(--p, 0) * 0.4);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-arrow { animation: none; }
  }
  @media (max-width: 768px) {
    .hero__overlay .hero__desc { font-size: 0.95rem; }
    .hero__hud { right: 1rem; bottom: 1rem; }
    .hero__progress { width: 80px; }
  }

  /* ===== INDUSTRY PAIN POINTS ===== */
  .pains-section { padding: 5rem 0 0; background: var(--black); }
  .pains-header { color: var(--white); margin-bottom: 3rem; }
  .pains-title { font-size: clamp(1.9rem, 4vw, 3rem); margin: 0.5rem 0 1rem; }
  .pains-sub { color: #aaa; max-width: 520px; line-height: 1.7; }

  .pains { display: flex; flex-direction: column; gap: 2px; }
  .pain-band {
    position: relative;
    overflow: hidden;
    min-height: 400px;
    display: flex;
    align-items: flex-end;
  }
  .pain-band::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--bg);
    background-size: cover;
    background-position: center;
    transition: transform 0.7s ease;
  }
  .pain-band:hover::before { transform: scale(1.05); }
  .pain-band::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(10,10,10,0.93) 0%, rgba(10,10,10,0.74) 48%, rgba(10,10,10,0.35) 100%);
  }
  .pain-band__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-top: 2.5rem;
    padding-bottom: 2.25rem;
    color: var(--white);
  }
  .pain-band__num {
    position: absolute;
    top: 1.25rem;
    right: 2rem;
    z-index: 1;
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 900;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.3);
  }
  .pain-band__title {
    font-size: clamp(2.2rem, 5.5vw, 4.25rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 1.02;
    max-width: 850px;
  }
  .pain-band__text {
    max-width: 560px;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 1rem;
    line-height: 1.65;
    font-size: 0.95rem;
  }

  .pains-closer {
    background: var(--green);
    color: var(--black);
    padding: 5rem 0;
    margin-top: 2px;
  }
  .pains-closer__title {
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin: 0.75rem 0 2.5rem;
  }
  .pains-closer__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    max-width: 760px;
    margin-bottom: 2.5rem;
  }
  .pains-closer__list li {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1.15rem 0;
    border-top: 2px solid var(--black);
  }
  .pains-closer__list li:last-child { border-bottom: 2px solid var(--black); }
  .pains-closer__num {
    flex-shrink: 0;
    width: 2.4rem;
    height: 2.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--black);
    color: var(--green);
    font-weight: 800;
    font-size: 0.85rem;
  }
  .pains-closer__list strong {
    display: block;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.65);
    margin-bottom: 0.25rem;
  }
  .pains-closer__list p { font-weight: 700; line-height: 1.55; font-size: 1rem; }
  .pains-closer .cta-block__actions { justify-content: flex-start; }

  @media (prefers-reduced-motion: reduce) {
    .pain-band::before { transition: none; }
    .pain-band:hover::before { transform: none; }
  }
  @media (max-width: 768px) {
    .pain-band { min-height: 300px; }
    .pain-band__num { right: 1rem; top: 0.9rem; }
    .pain-band::after {
      background: linear-gradient(90deg, rgba(10,10,10,0.94) 0%, rgba(10,10,10,0.8) 60%, rgba(10,10,10,0.55) 100%);
    }
  }

  .compliance-row {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .compliance-row p { font-size: 0.85rem; color: #666; margin-top: 0.2rem; }

  .calc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
  .calc-title { font-size: clamp(2rem, 4vw, 3rem); margin-bottom: 1rem; }
  .calc-desc { color: #aaa; margin-bottom: 1.5rem; line-height: 1.7; }

  .industry-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2.5rem; }
  .view-all { font-size: 0.7rem; }
  .explore-link { display: inline-block; margin-top: 1.5rem; font-weight: 700; font-size: 0.85rem; }

  .faq-section { background: #f5f5f5; }
  .faq-container { max-width: 800px; }
  .faq-container h2 { margin-bottom: 2rem; }
  .faq-list { display: flex; flex-direction: column; }
  .faq-item { border-top: 2px solid #0a0a0a; }
  .faq-item:last-child { border-bottom: 2px solid #0a0a0a; }
  .faq-item summary {
    padding: 1.25rem 0;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.95rem;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; font-size: 1.5rem; font-weight: 300; }
  .faq-item[open] summary::after { content: '−'; }
  .faq-item p { padding-bottom: 1.25rem; color: #444; line-height: 1.7; font-size: 0.9rem; }

  @media (max-width: 768px) {
    .calc-grid { grid-template-columns: 1fr; gap: 2rem; }
    .industry-header { flex-direction: column; align-items: flex-start; gap: 1rem; }
  }
</style>

<script>
  const pallets = document.getElementById('pallets') as HTMLInputElement;
  const rate = document.getElementById('rate') as HTMLInputElement;
  const currency = document.getElementById('currency') as HTMLSelectElement;
  const output = document.getElementById('savings-output');

  // ~20kg tare weight saved per pallet (5kg honeycomb vs 25kg wood)
  const KG_SAVED_PER_PALLET = 20;
  // Typical air freight rates per KG by currency (editable by the user)
  const DEFAULT_RATES: Record<string, number> = { RM: 20, USD: 4.5 };

  const fmt = (cur: string, v: number) => {
    const n = v.toLocaleString('en-US', { maximumFractionDigits: 0 });
    return cur === 'USD' ? `$${n}` : `RM ${n}`;
  };

  function calc() {
    const cur = currency?.value || 'RM';
    const n = parseFloat(pallets?.value) || 0;
    const r = parseFloat(rate?.value) || 0;
    const savings = n * KG_SAVED_PER_PALLET * r;
    if (output) output.textContent = `${fmt(cur, savings)} / mo`;
  }

  pallets?.addEventListener('input', calc);
  rate?.addEventListener('input', calc);
  currency?.addEventListener('change', () => {
    if (rate) rate.value = String(DEFAULT_RATES[currency.value] ?? 20);
    calc();
  });

  // ===== Animated scroll-scrub hero =====
  const hero = document.querySelector('.hero') as HTMLElement | null;
  const heroVideo = hero?.querySelector('.hero__video') as HTMLVideoElement | null;
  const heroCaption = hero?.querySelector('[data-hero-caption]') as HTMLElement | null;

  if (hero && heroVideo) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const canScrub = window.matchMedia('(min-width: 769px) and (pointer: fine)').matches && !reduceMotion;

    if (canScrub) {
      const captions: [number, string][] = [
        [0, 'Flat honeycomb board'],
        [0.35, 'Folding into shape'],
        [0.7, 'Assembling cargo box'],
        [0.92, 'Detached honeycomb container'],
      ];

      const enableScrub = () => {
        hero.classList.add('hero--scroll');
        heroVideo.removeAttribute('autoplay');
        heroVideo.loop = false;
        heroVideo.pause();

        const dur = heroVideo.duration && isFinite(heroVideo.duration) ? heroVideo.duration : 5;
        let target = 0;
        let running = false;

        const setCaption = (p: number) => {
          if (!heroCaption) return;
          let txt = captions[0][1];
          for (const [thr, t] of captions) if (p >= thr) txt = t;
          if (heroCaption.textContent !== txt) heroCaption.textContent = txt;
        };

        const computeTarget = () => {
          const scrollable = hero.offsetHeight - window.innerHeight;
          const p = scrollable > 0
            ? Math.min(1, Math.max(0, -hero.getBoundingClientRect().top / scrollable))
            : 0;
          hero.style.setProperty('--p', p.toFixed(4));
          setCaption(p);
          target = p * (dur - 0.05);
        };

        const tick = () => {
          const cur = heroVideo.currentTime;
          const diff = target - cur;
          if (Math.abs(diff) > 0.008) {
            try { heroVideo.currentTime = cur + diff * 0.18; } catch (e) {}
            requestAnimationFrame(tick);
          } else {
            try { heroVideo.currentTime = target; } catch (e) {}
            running = false;
          }
        };
        const kick = () => { if (!running) { running = true; requestAnimationFrame(tick); } };

        window.addEventListener('scroll', () => { computeTarget(); kick(); }, { passive: true });
        window.addEventListener('resize', () => { computeTarget(); kick(); }, { passive: true });
        computeTarget();
        kick();
      };

      if (heroVideo.readyState >= 1) enableScrub();
      else heroVideo.addEventListener('loadedmetadata', enableScrub, { once: true });
    } else {
      // Fallback (mobile / reduced motion): gentle autoplay loop
      heroVideo.muted = true;
      heroVideo.play?.().catch(() => {});
    }
  }
</script>
