---
import StoryPost from "../../../components/StoryPost.astro";
import { posts } from "../../../content/stories";

export function getStaticPaths() {
  return posts
    .filter((p) => (p.i18n as any).ja)
    .map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
---

<StoryPost slug={slug!} locale="ja" />
